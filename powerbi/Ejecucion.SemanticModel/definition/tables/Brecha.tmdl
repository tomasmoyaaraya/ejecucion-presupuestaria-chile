table Brecha

	column año
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: año

	column oficial
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: oficial

	column corte
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: corte

	column periodo
		dataType: string
		sortByColumn: año
		summarizeBy: none
		sourceColumn: periodo

	partition Brecha = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "\brecha.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"año", Int64.Type}, {"oficial", type number}, {"corte", type number}, {"periodo", type text}}, "en-US")
				in
				    Tipos

