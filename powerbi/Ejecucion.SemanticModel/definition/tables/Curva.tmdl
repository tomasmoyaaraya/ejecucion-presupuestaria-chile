table Curva

	column n
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: n

	column etiqueta
		dataType: string
		sortByColumn: n
		summarizeBy: none
		sourceColumn: etiqueta

	column proyeccion
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: proyeccion

	column modelo
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: modelo

	partition Curva = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "\curva.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"n", Int64.Type}, {"etiqueta", type text}, {"proyeccion", Int64.Type}, {"modelo", Int64.Type}}, "en-US")
				in
				    Tipos

